# Supabase Auth configuration for micro-supabase demo
# See https://github.com/supabase/auth for all options

# Database
GOTRUE_DB_DATABASE_URL=postgres://postgres:password@127.0.0.1:54321/template1?sslmode=disable
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_NAMESPACE=auth

# API
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
API_EXTERNAL_URL=http://localhost:9999
GOTRUE_SITE_URL=http://localhost:3000

# JWT (shared with PostgREST)
GOTRUE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated

# Email (auto-confirm for local demo)
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true

# Disable external OAuth providers
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_DISABLE_SIGNUP=false

# Logging
GOTRUE_LOG_LEVEL=info
